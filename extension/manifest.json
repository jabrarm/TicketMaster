{
  "manifest_version": 3,
  "name": "TicketMaster – Verfügbarkeitsmonitor",
  "version": "1.0.0",
  "description": "Zeigt freie Sitze und Änderungen anhand der vom Hospitality-Shop geladenen Sitzdaten.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ticket-Verfügbarkeit öffnen / schließen"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/areaplan/venue/event/*"],
      "js": ["availability-core.js", "page-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/areaplan/venue/event/*"],
      "js": ["availability-core.js", "monitor.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
