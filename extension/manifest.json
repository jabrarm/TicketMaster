{
  "manifest_version": 3,
  "name": "TicketMaster – Verfügbarkeitsmonitor",
  "version": "1.1.1",
  "description": "Wählt Sitzplätze nach Ticketanzahl und Kategoriepräferenzen und übergibt bestätigte Plätze an den Warenkorb des Hospitality-Shops.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ticket-Verfügbarkeit öffnen / schließen"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/areaplan/venue/event/*"],
      "js": ["availability-core.js", "preferences.js", "cart-flow.js", "page-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/areaplan/venue/event/*"],
      "js": ["availability-core.js", "preferences.js", "preferences-ui.js", "monitor.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
