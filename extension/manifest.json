{
  "manifest_version": 3,
  "name": "TicketMaster – Verfügbarkeitsmonitor",
  "version": "1.4.4",
  "minimum_chrome_version": "116",
  "options_page": "audio-options.html",
  "description": "Wählt Sitzplätze im regulären Werder-Einzelkartenshop und Hospitality-Shop nach Ticketanzahl und Kategoriepräferenzen.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ticket-Verfügbarkeit öffnen / schließen"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/areaplan/venue/event/*", "https://www.ticket-onlineshop.com/ols/werderbremen/de/einzelkarten/channel/shop/areaplan/venue/event/*"],
      "js": ["availability-core.js", "preferences.js", "cart-receipt.js", "cart-flow.js", "refresh.js", "page-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/areaplan/venue/event/*", "https://www.ticket-onlineshop.com/ols/werderbremen/de/einzelkarten/channel/shop/areaplan/venue/event/*"],
      "js": ["availability-core.js", "preferences.js", "preferences-ui.js", "monitor.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.ticket-onlineshop.com/ols/werderbremen-hospitality/de/tageskarte/channel/shop/shoppingcart*", "https://www.ticket-onlineshop.com/ols/werderbremen/de/einzelkarten/channel/shop/shoppingcart*"],
      "js": ["availability-core.js", "cart-receipt.js", "cart-return.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
